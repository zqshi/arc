# ─── LLM Provider ─────────────────────────────────────
ARC_LLM_PROVIDER=anthropic          # anthropic / openai / deepseek

ARC_OPENAI_API_KEY=
ARC_OPENAI_BASE_URL=https://api.openai.com/v1
ARC_OPENAI_MODEL=gpt-4o

ARC_ANTHROPIC_API_KEY=
ARC_ANTHROPIC_BASE_URL=https://api.anthropic.com
ARC_ANTHROPIC_MODEL=claude-sonnet-4-6

ARC_DEEPSEEK_API_KEY=
ARC_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ARC_DEEPSEEK_MODEL=deepseek-chat

# ─── Coding Agent ─────────────────────────────────────
ARC_OPENHANDS_API_KEY=

# ─── Database ─────────────────────────────────────────
ARC_DB_PORT=5433

# ─── Auth / JWT ───────────────────────────────────────
ARC_JWT_SECRET=                      # 生产环境必须设置，建议 64 字符随机串
ARC_SMS_MOCK_MODE=true               # true = 开发模式固定验证码 666666

# ─── App ──────────────────────────────────────────────
ARC_DEBUG=false
