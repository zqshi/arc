# ═══════════════════════════════════════════════════════════
# Arc 环境变量配置
# 此文件与 backend/src/arc/config.py Settings 类字段一一对应
# 所有变量均以 ARC_ 为前缀
# ═══════════════════════════════════════════════════════════

# ─── 应用基础 ─────────────────────────────────────────────
ARC_APP_NAME=Arc                         # 应用名称
ARC_DEBUG=false                          # true 启用调试模式（自动注入种子账号、开放 CORS、降低安全校验）

# ─── 数据库 ───────────────────────────────────────────────
ARC_DATABASE_URL=postgresql+asyncpg://arc:arc@localhost:5432/arc
ARC_DATABASE_ECHO=false                  # true 打印所有 SQL 语句
ARC_DB_PORT=5433                         # Docker Compose 映射的宿主机端口
ARC_DB_POOL_SIZE=10                      # 连接池大小
ARC_DB_MAX_OVERFLOW=20                   # 连接池溢出上限
ARC_DB_POOL_RECYCLE=3600                 # 连接回收时间（秒）

# ─── Redis (v6.7 多 worker 前置) ─────────────────────────
# 跨进程事件总线, 启用 uvicorn 多 worker。空 = 退回单 worker InMemory 模式 (dev/单测默认)
# 生产多 worker 必配, 如 redis://redis:6379/0
ARC_REDIS_URL=
ARC_WORKERS=1                            # uvicorn worker 数; >1 需配 ARC_REDIS_URL

# ─── CORS ─────────────────────────────────────────────────
# 生产环境必须配置为实际前端域名，多个用 JSON 数组格式
ARC_CORS_ORIGINS=                        # 如 '["https://your-domain.com"]', DEBUG 模式自动追加 localhost

# ─── 认证 / JWT ──────────────────────────────────────────
ARC_JWT_SECRET=                          # 生产环境必填！建议 64 字符随机串（openssl rand -hex 32）
ARC_JWT_ACCESS_EXPIRE_MINUTES=30         # Access Token 有效期（分钟）
ARC_JWT_REFRESH_EXPIRE_DAYS=7            # Refresh Token 有效期（天）
ARC_SMS_MOCK_MODE=true                   # true = 开发模式固定验证码 666666

# ─── LLM Provider ────────────────────────────────────────
ARC_LLM_PROVIDER=openai                  # openai / anthropic / deepseek

# OpenAI
ARC_OPENAI_API_KEY=
ARC_OPENAI_BASE_URL=https://api.openai.com/v1
ARC_OPENAI_MODEL=gpt-4o

# Anthropic
ARC_ANTHROPIC_API_KEY=
ARC_ANTHROPIC_BASE_URL=                  # 留空使用官方地址
ARC_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek
ARC_DEEPSEEK_API_KEY=
ARC_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ARC_DEEPSEEK_MODEL=deepseek-chat

# ─── Coding Agent ────────────────────────────────────────
# OpenHands
ARC_OPENHANDS_URL=http://localhost:3000
ARC_OPENHANDS_API_KEY=

# Codex
ARC_CODEX_API_KEY=
ARC_CODEX_BASE_URL=https://api.openai.com/v1

# Claude Code
ARC_CLAUDE_CODE_PATH=                    # claude-code CLI 可执行文件路径
ARC_CLAUDE_CODE_WORK_DIR=                # 工作目录
ARC_CLAUDE_CODE_MODEL=                   # 模型名称（留空使用 CLI 默认）

# Cursor
ARC_CURSOR_CLI_PATH=                     # cursor CLI 路径

# ─── Agent 编排 ──────────────────────────────────────────
ARC_AGENT_DEFAULT=openhands              # 默认 agent（openhands / codex / claude_code / cursor）
ARC_AGENT_DEVELOPMENT=                   # 开发阶段 agent 覆盖（留空使用默认）
ARC_AGENT_TESTING=                       # 测试阶段 agent 覆盖
ARC_AGENT_DEPLOYMENT=                    # 部署阶段 agent 覆盖

# ─── Worker 子模型 ──────────────────────────────────────
ARC_WORKER_LLM_PROVIDER=                 # Worker 子模型 provider（留空跟主模型）
ARC_WORKER_MODEL=                        # Worker 子模型名称
ARC_MAX_CONCURRENT_WORKERS=3             # Worker 最大并发数

# ─── 沙箱 ───────────────────────────────────────────────
ARC_SANDBOX_DEFAULT_MODE=none            # 沙箱默认模式 (none / docker / e2b)
# 构建镜像覆盖 (可选): 覆盖默认镜像映射, key 格式 "{project_type}:{build_target}"
# 留空则用 domain/sandbox/build_images.py 的 DEFAULT_BUILD_IMAGES 注册表
# 例: ARC_SANDBOX_BUILDER_IMAGES={"binary_app:tauri_linux":"registry.example.com/tauri:v2"}
# ARC_SANDBOX_BUILDER_IMAGES=

# ─── Object Storage (S3兼容) ─────────────────────────────
# 留空则降级为本地文件存储（/static/previews/）
ARC_STORAGE_ENDPOINT=                    # MinIO: http://localhost:9000, AWS: https://s3.amazonaws.com
ARC_STORAGE_ACCESS_KEY=minioadmin
ARC_STORAGE_SECRET_KEY=minioadmin
ARC_STORAGE_BUCKET=arc-previews
ARC_STORAGE_PUBLIC_URL=                  # CDN 或公开访问前缀, 如 http://localhost:9000/arc-previews
ARC_PREVIEW_STATIC_DIR=                  # 本地存储模式(无 storage_endpoint)预览目录; 容器必指可写卷如 /app/data/static/previews

# ─── Deployment (v5.4.0 新增) ────────────────────────────
ARC_DEPLOY_PATH_PREFIX=deployments       # 部署产物在 bucket 内的 key 前缀
ARC_DEPLOY_CDN_DOMAIN=                   # 接 CDN 后填, 留空则用 storage_public_url 直出
ARC_DEPLOY_MAX_FILE_SIZE=52428800        # 单文件上限 50MB (50 * 1024 * 1024)

# ─── Signing (v6.1.0) — 签名凭证加密密钥 ─────────────────
# Fernet 密钥, 加密各项目配置的签名凭证 (Apple/Win/Android)。空=dev 降级明文 (生产必配)
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARC_SIGNING_SECRET_KEY=

# ─── BaaS / Supabase (v5.6.0 新增) ────────────────────────
ARC_SUPABASE_DB_URL=                     # 留空则复用 ARC_DATABASE_URL (dev: 同库 arc_ schema 隔离); 生产填真实 Supabase Postgres DSN
ARC_SUPABASE_SCHEMA_PREFIX=arc_          # schema 隔离前缀, 需与 BaasSchema 约定一致
ARC_SUPABASE_API_URL=http://localhost:54321  # PostgREST endpoint, 注入生成前端 VITE_SUPABASE_URL
ARC_SUPABASE_ANON_KEY=dev-anon-key       # 注入生成前端 VITE_SUPABASE_ANON_KEY (生产填真实 anon key)

# ─── Docker Compose 生产部署 ─────────────────────────────
POSTGRES_USER=arc                        # 数据库用户名
POSTGRES_PASSWORD=                       # 数据库密码（生产必填）
POSTGRES_DB=arc                          # 数据库名
ARC_PORT=80                              # 前端对外端口（docker-compose.prod.yml）
ARC_BACKEND_IMAGE=arc-backend:latest     # 后端镜像（可改为 GHCR 地址）
ARC_FRONTEND_IMAGE=arc-frontend:latest   # 前端镜像（可改为 GHCR 地址）
