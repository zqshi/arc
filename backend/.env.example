# Arc Backend Configuration
# Copy this file to .env and fill in your values

# ── Application ────────────────────────────────────────────
ARC_APP_NAME=Arc
ARC_DEBUG=true

# ── Database ───────────────────────────────────────────────
ARC_DATABASE_URL=postgresql+asyncpg://arc:arc@localhost:5432/arc
ARC_DATABASE_ECHO=false

# ── Redis (v6.7 多 worker 前置) ──────────────────────────
# 跨进程事件总线, 启用多 worker。空 = 退回单 worker InMemory 模式
ARC_REDIS_URL=
# ARC_WORKERS: uvicorn 启动参数(--workers), 非 arc Settings 字段; dev 默认单 worker
# 多 worker 生产部署见 docker-compose.prod.yml / k8s (走环境变量, 不入本 .env)

# ── Database Pool ──────────────────────────────────────────
ARC_DB_POOL_SIZE=10
ARC_DB_MAX_OVERFLOW=20
ARC_DB_POOL_RECYCLE=3600

# ── CORS ───────────────────────────────────────────────────
# JSON array, e.g. ["http://localhost:5173"]
ARC_CORS_ORIGINS=[]

# ── Auth / JWT ─────────────────────────────────────────────
ARC_JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
ARC_JWT_ACCESS_EXPIRE_MINUTES=30
ARC_JWT_REFRESH_EXPIRE_DAYS=7
ARC_SMS_MOCK_MODE=false

# ── LLM Provider (全局默认 fallback / seed 兜底) ────────
# v6.20: 多厂商凭证管理走 DB (POST /api/llm/providers, Fernet 加密),
#        下列 env 字段降级为全局默认兜底 (DB 无凭证时用), 向后兼容现有 env 部署。
#        项目级覆盖用 Project.llm_provider_id 指针指向 DB 凭证。
ARC_LLM_PROVIDER=openai

# OpenAI (also used for embedding when provider is anthropic)
ARC_OPENAI_API_KEY=sk-xxx
ARC_OPENAI_BASE_URL=https://api.openai.com/v1
ARC_OPENAI_MODEL=gpt-4o

# Anthropic
ARC_ANTHROPIC_API_KEY=
ARC_ANTHROPIC_BASE_URL=
ARC_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek
ARC_DEEPSEEK_API_KEY=
ARC_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ARC_DEEPSEEK_MODEL=deepseek-chat

# ── OpenHands ──────────────────────────────────────────────
ARC_OPENHANDS_URL=http://localhost:3000
ARC_OPENHANDS_API_KEY=

# ── Codex (OpenAI Codex API) ──────────────────────────────
ARC_CODEX_API_KEY=
ARC_CODEX_BASE_URL=https://api.openai.com/v1

# ── Claude Code (local CLI) ──────────────────────────────
ARC_CLAUDE_CODE_PATH=
ARC_CLAUDE_CODE_WORK_DIR=
ARC_CLAUDE_CODE_MODEL=

# ── Cursor (local CLI) ───────────────────────────────────
ARC_CURSOR_CLI_PATH=

# ── Agent orchestration (openhands/codex/claude_code/cursor)
ARC_AGENT_DEFAULT=openhands
ARC_AGENT_DEVELOPMENT=
ARC_AGENT_TESTING=
ARC_AGENT_DEPLOYMENT=

# ── Worker model (for multi-agent sub-tasks) ────────────
ARC_WORKER_LLM_PROVIDER=
ARC_WORKER_MODEL=
ARC_MAX_CONCURRENT_WORKERS=3

# ── Sandbox ─────────────────────────────────────────────
ARC_SANDBOX_DEFAULT_MODE=none
# 构建镜像覆盖 (可选): 覆盖默认镜像映射, key 格式 "{project_type}:{build_target}"
# 开发态留空 → src/arc/domain/sandbox/build_images.py 的 DEFAULT_BUILD_IMAGES 注册表 (本地 arc/xxx 名)
# 生产环境: CI (docker-publish.yml build-builder-images) 在 release tag 时发布 ghcr 镜像,
# 此处覆盖映射 (替换 <owner>/<repo> 为实际 GitHub 仓库):
# ARC_SANDBOX_BUILDER_IMAGES={"binary_app:tauri_linux":"ghcr.io/<owner>/<repo>-tauri-builder:latest","binary_app:web":"ghcr.io/<owner>/<repo>-web-builder:latest","binary_app:capacitor_apk":"ghcr.io/<owner>/<repo>-android-builder:latest"}
# ARC_SANDBOX_BUILDER_IMAGES=  (留空=用默认注册表, 见上; dict 字段空值无效, 勿写裸 =)

# ── OpenSandbox 云沙箱 (v6.7, mode=open_sandbox) ────────
ARC_OPENSANDBOX_URL=
ARC_OPENSANDBOX_API_KEY=
ARC_OPENSANDBOX_IMAGE=python:3.12-slim

# ── GitHub Actions CI 编排 (v6.19, CI target 构建) ──────
# CI target (tauri_windows/capacitor_ios/harmony_hap) 走 GHA workflow 编排构建。
# token 需 actions:write 权限; owner/repo 为承载 build-client-artifacts.yml 的仓库。
# 留空 → CI target 构建不可用 (非 CI target 不受影响)
ARC_GHA_TOKEN=
ARC_GHA_OWNER=
ARC_GHA_REPO=

# ── Object Storage (S3-compatible: MinIO / AWS S3 / OSS) ─
ARC_STORAGE_ENDPOINT=
ARC_STORAGE_ACCESS_KEY=
ARC_STORAGE_SECRET_KEY=
ARC_STORAGE_BUCKET=arc-previews
ARC_STORAGE_PUBLIC_URL=
# 本地存储模式(无 storage_endpoint)预览目录; 容器必指可写卷如 /app/data/static/previews
ARC_PREVIEW_STATIC_DIR=

# Deployment
ARC_DEPLOY_PATH_PREFIX=deployments
ARC_DEPLOY_CDN_DOMAIN=
ARC_DEPLOY_MAX_FILE_SIZE=52428800

# ── Signing (v6.1.0) — 签名凭证加密密钥 (凭证项目维度加密存储) ─
# Fernet 密钥, 加密各项目配置的签名凭证 (Apple/Win/Android)。空=dev 降级明文 (生产必配)
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARC_SIGNING_SECRET_KEY=

# ── BaaS (v5.6.0) — Supabase PG (注入交付项目的后端) ───────
# supabase_db_url 留空则复用 ARC_DATABASE_URL (dev: 应用 schema 与 Arc 元数据同库,
#   靠 arc_{project_id} 前缀隔离); 生产填真实 Supabase Postgres DSN
ARC_SUPABASE_DB_URL=
ARC_SUPABASE_SCHEMA_PREFIX=arc_
# 注入前端工程的 Supabase 连接 (dev 默认本地 PostgREST, 生产填真实 Supabase)
ARC_SUPABASE_ANON_KEY=dev-anon-key
ARC_SUPABASE_API_URL=http://localhost:54321

# ── Observability (A2) — /metrics bearer token ─────────────
# 空=不校验 (dev/集群内网, Prometheus scraper 无登录态); 生产配随机 token
# scraper 配 Authorization: Bearer <token>。生成: openssl rand -hex 32
ARC_PROMETHEUS_TOKEN=
